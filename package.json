{
    "name": "iobroker.tractive-gps",
    "version": "2.1.0",
    "description": "This adapter allows you to connect to the Tractive GPS service and retrieve the location of your pets.",
    "author": {
        "name": "xXBJXx",
        "email": "issi.dev.iobroker@gmail.com"
    },
    "contributors": [
        {
            "name": "xXBJXx",
            "email": "issi.dev.iobroker@gmail.com"
        },
        {
            "name": "iobroker-community-adapters",
            "email": "mcm57@gmx.at"
        }
    ],
    "homepage": "https://github.com/iobroker-community-adapters/ioBroker.tractive-gps",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "tractive",
        "gps",
        "geoposition",
        "geolocation",
        "tracking",
        "dog",
        "cat",
        "pet"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/iobroker-community-adapters/ioBroker.tractive-gps.git"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "workspaces": [
        "src-admin",
        "src-widgets"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "axios": "^1.19.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-lerna": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/dev-server": "https://codeload.github.com/xXBJXx/dev-server/tar.gz/c0338ae",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "@types/chai": "^5.2.2",
        "@types/chai-as-promised": "^8.0.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.19.19",
        "@types/sinon": "^17.0.4",
        "@types/sinon-chai": "^4.0.0",
        "@types/source-map-support": "^0.5.10",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "chai": "^5.2.1",
        "chai-as-promised": "^7.1.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.6.0",
        "lerna": "^10.0.1",
        "mocha": "^11.8.0",
        "prettier": "^3.8.4",
        "rimraf": "^6.1.3",
        "sinon": "^22.1.0",
        "sinon-chai": "^4.0.0",
        "tiny-glob": "^0.2.9",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.60.0"
    },
    "main": "build/main.js",
    "files": [
        "admin/i18n/",
        "admin/index_m.html",
        "admin/index.js",
        "admin/tractive-gps.png",
        "admin/tractive-logo.svg",
        "build/",
        "widgets/",
        "io-package.json",
        "README_DE.md",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "rimraf build admin/build admin/.watch",
        "build": "build-adapter ts && npm run build:admin && npm run build:widgets",
        "build:admin": "npm --workspace @tractive-gps/admin run build",
        "build:widgets": "npm --workspace @tractive-gps/vis-widgets run build",
        "watch": "build-adapter ts --watch",
        "prebuild:ts": "rimraf build",
        "build:ts": "build-adapter ts",
        "watch:ts": "build-adapter ts --watch",
        "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
        "test:package": "mocha test/package --exit",
        "test:integration": "mocha test/integration --exit",
        "test": "npm run test:ts && npm run test:package",
        "check": "tsc --noEmit && npm --workspace @tractive-gps/admin run check && npm --workspace @tractive-gps/vis-widgets run check",
        "lint": "eslint src && npm --workspace @tractive-gps/admin run lint && npm --workspace @tractive-gps/vis-widgets run lint",
        "lint:fix": "eslint --fix src",
        "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts,tsx}\"",
        "translate": "translate-adapter",
        "release": "release-script",
        "npm": "npm i",
        "dev-server": "dev-server",
        "dev": "dev-server watch --noStart",
        "dev-setup": "dev-server setup",
        "dev-update": "dev-server update",
        "dev-upload": "dev-server upload"
    },
    "nyc": {
        "include": [
            "src/**/*.ts"
        ],
        "exclude": [
            "src/**/*.test.ts"
        ],
        "extension": [
            ".ts"
        ],
        "require": [
            "ts-node/register"
        ],
        "reporter": [
            "text-summary",
            "html"
        ],
        "sourceMap": true,
        "instrument": true
    },
    "bugs": {
        "url": "https://github.com/iobroker-community-adapters/ioBroker.tractive-gps/issues"
    },
    "readmeFilename": "README.md",
    "overrides": {
        "jws": "^3.2.3"
    }
}

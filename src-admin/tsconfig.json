{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "strict": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "types": ["@iobroker/types"]
    },
    "include": ["src", "vite.config.ts"]
}
